generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  
  // Membership
  isMember      Boolean   @default(false)
  membershipExpiresAt DateTime?
  stripeCustomerId String? @unique
  subscriptionId   String? @unique
  
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  CUSTOMER
}

model AvailabilitySchedule {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique // 0 = Sunday, 1 = Monday, etc.
  startTime String   // e.g., "09:00"
  endTime   String   // e.g., "17:00"
  isWorking Boolean  @default(true)
}

model AvailabilityOverride {
  id        String   @id @default(cuid())
  date      DateTime @unique // specific date (e.g., 2026-12-25), should be stored at midnight UTC
  isWorking Boolean  @default(false)
  startTime String?  // e.g., "10:00"
  endTime   String?  // e.g., "14:00"
}

model Booking {
  id              String    @id @default(cuid())
  userId          String
  offeringSlug    String    // References the Offering in Sanity CMS
  startTime       DateTime
  endTime         DateTime
  pricePaid       Float     @default(0) // 0 if member
  status          BookingStatus @default(PENDING)
  stripeSessionId String?   @unique
  calendarEventId String?
  customerEmail   String?
  meetingUrl      String?
  meetingHostUrl  String?
  meetingId       String?
  meetingPassword String?

  user            User      @relation(fields: [userId], references: [id])
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Index on times for fast query of overlaps
  @@index([startTime, endTime])
  @@index([userId])
  @@index([calendarEventId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String              // e.g. "Breathe & Flow" or custom name
  date        DateTime             // The date of the event (stored at midnight UTC)
  startTime   String              // e.g. "10:00"
  endTime     String              // e.g. "11:00"
  price       Float    @default(0) // Price in GBP
  isPublished Boolean  @default(false) // Draft until admin clicks "Save Calendar"

  // One online meeting per class, created on the first booking and shared by every attendee.
  meetingProvider String?
  meetingUrl      String?
  meetingHostUrl  String?
  meetingId       String?
  meetingPassword String?
  externalEventId String?  // Google Calendar event id (for adding attendees)

  bookings    Booking[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([date])
  @@index([isPublished, date])
}

model ClassType {
  id          String   @id @default(cuid())
  name        String   @unique       // e.g. "Breathe & Flow"
  price       Float    @default(0)   // Default price in GBP
  duration    Int      @default(60)  // Default duration in minutes
  color       String   @default("#4A6FA5") // Display color for calendar
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IntegrationCredential {
  provider     String   @id // e.g. "google"
  accountEmail String?
  refreshToken String
  updatedAt    DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
